{
	"name": "nl-event",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "rescript && sh scripts/dev.sh",
		"build": "rescript && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "rescript && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "rescript && concurrently -k \"rescript watch\" \"svelte-check --tsconfig ./tsconfig.json --watch\"",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "rescript && vitest run",
		"res:build": "rescript",
		"test:browser": "rescript && node tests/browser-smoke.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"concurrently": "^10.0.6",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.64.1",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"rescript": "^12.3.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@js-temporal/polyfill": "^0.5.1",
		"@leftium/nimble.css": "^0.24.1",
		"@rescript/runtime": "^12.3.1",
		"compromise": "^14.19.0",
		"compromise-dates": "^3.10.0",
		"linkifyjs": "^4.4.0"
	}
}
